{
  "name": "teraMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android-release": "react-native run-android --mode release",
    "ios-release": "react-native run-ios --mode Release",
    "ios-15-pro": "react-native run-ios --simulator='iPhone 15 pro'",
    "ios-se": "react-native run-ios --simulator='iPhone SE (3rd generation)'",
    "ios-device": "npx react-native run-ios --device='Your iPhone'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --write .",
    "start": "watchman watch-del-all && react-native start --reset-cache",
    "test": "jest",
    "type-check": "tsc --noemit --skipLibCheck",
    "test:related": "jest --watchAll=false --findRelatedTests --forceExit",
    "test:report": "jest --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --coverage",
    "pod-install": "cd ios && RCT_NEW_ARCH_ENABLED=1 bundle exec pod install && cd ..",
    "reinstall": "rm -rf node_modules && yarn install && yarn reinstall:pods",
    "reinstall:pods": "cd ios && rm -rf Pods && pod install",
    "verify": "yarn type-check && yarn prettier && yarn lint",
	"force:clean": "yarn cache clean && cd ios && pod cache clean --all && cd .. && rm -rf ~/Library/Developer/Xcode/DerivedData && cd android && ./gradlew clean && cd ..",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "yarn verify"
  },
  "dependencies": {
    "@cassianosch/react-native-keyboard-sticky-footer-avoiding-scroll-view": "^1.0.5",
    "@gorhom/bottom-sheet": "4.5.1",
    "@react-native-clipboard/clipboard": "1.11.2",
    "@react-native-community/blur": "^4.3.2",
    "@react-native-community/netinfo": "^11.3.0",
    "@react-native-masked-view/masked-view": "^0.3.0",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/elements": "^1.3.21",
    "@react-navigation/material-top-tabs": "6.6.4",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "@reduxjs/toolkit": "^1.9.5",
    "@twotalltotems/react-native-otp-input": "^1.3.11",
    "async-mutex": "0.4.0",
    "axios": "0.19.2",
    "dayjs": "^1.11.10",
    "events": "^3.3.0",
    "i18next": "^23.2.3",
    "lottie-react-native": "^6.5.1",
    "mitt": "^3.0.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react": "18.2.0",
    "react-hook-form": "7.47.0",
    "react-i18next": "^13.0.1",
    "react-native": "0.73.4",
    "react-native-animatable": "^1.4.0",
    "react-native-autocomplete-input": "^5.4.0",
    "react-native-biometrics": "^3.0.1",
    "react-native-blob-util": "0.19.4",
    "react-native-calendars": "1.1302.0",
    "react-native-contact-pick": "^0.1.2",
    "react-native-contacts": "^7.0.8",
    "react-native-device-info": "^10.11.0",
    "react-native-document-picker": "^9.1.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keychain": "^8.1.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^2.10.0",
    "react-native-modal": "^13.0.1",
    "react-native-pager-view": "^6.2.2",
    "react-native-pdf": "6.7.4",
    "react-native-permissions": "^4.1.1",
    "react-native-reanimated": "3.6.1",
    "react-native-safe-area-context": "^4.6.3",
    "react-native-screens": "^3.22.0",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-static-safe-area-insets": "^2.2.0",
    "react-native-svg": "14.0.0",
    "react-native-tab-view": "3.5.2",
    "react-redux": "^8.1.1",
    "redux-persist": "^6.0.0",
    "rn-android-keyboard-adjust": "^2.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@react-navigation/devtools": "^6.0.19",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^12.1.2",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.5.5",
    "@types/metro-config": "^0.76.3",
    "@types/node": "^20.8.9",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.72.2",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-root-import": "^6.6.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.19.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.3",
    "lint-staged": "^14.0.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.10",
    "react-native-flipper": "^0.212.0",
    "react-test-renderer": "18.2.0",
    "redux-flipper": "^2.0.2",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18"
  }
}
